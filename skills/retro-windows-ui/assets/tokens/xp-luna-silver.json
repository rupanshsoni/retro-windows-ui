{
  "schemaVersion": "1.0.0",
  "identity": {
    "id": "xp-luna-silver",
    "name": "Luna Silver",
    "family": "xp-luna",
    "era": "Windows XP",
    "variant": "silver",
    "description": "Rounded Luna chrome, glossy controls, pill-like taskbar buttons, and short eased transitions."
  },
  "typography": {
    "fontFamily": "Tahoma, 'MS Sans Serif', Geneva, sans-serif",
    "fontFamilyMono": "'Courier New', Courier, monospace",
    "roles": {
      "body": {
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.35"
      },
      "windowTitle": {
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.1"
      },
      "menu": {
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.25"
      },
      "small": {
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.3"
      },
      "code": {
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.4"
      }
    }
  },
  "colors": {
    "surface": {
      "desktop": "#8d8da7",
      "window": "#ece9d8",
      "windowSolid": "#ece9d8",
      "control": "#f8f8f2",
      "input": "#ffffff",
      "inset": "#ffffff",
      "menu": "#ffffff",
      "tooltip": "#ffffe1",
      "overlay": "rgb(0 0 0 / 32%)"
    },
    "text": {
      "primary": "#101010",
      "secondary": "#3e3e38",
      "muted": "#55554e",
      "disabled": "#8b8b80",
      "inverse": "#ffffff",
      "link": "#0645ad",
      "error": "#a40000"
    },
    "border": {
      "default": "#182036",
      "light": "#ffffff",
      "dark": "#182036",
      "shadow": "#5d5d55",
      "highlight": "#f5f5f8"
    },
    "bevel": {
      "outerLight": "#ffffff",
      "outerDark": "#182036",
      "innerLight": "#f5f5f8",
      "innerDark": "#b8b8aa",
      "pressedLight": "#182036",
      "pressedDark": "#ffffff"
    },
    "selection": {
      "background": "#8d8da7",
      "text": "#10182c",
      "inactiveBackground": "#c5c5ba",
      "inactiveText": "#3d3d38"
    },
    "focus": {
      "color": "#303b6c",
      "ring": "1px dotted #182036",
      "alternate": "#ffffff"
    },
    "titlebar": {
      "activeBackground": "#8d8da7",
      "activeBackgroundEnd": "#c7c7d4",
      "activeText": "#10182c",
      "inactiveBackground": "#c8c8bd",
