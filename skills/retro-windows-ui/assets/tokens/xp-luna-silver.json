      "inactiveText": "#5e5e58",
      "button": "#e8e8ef",
      "buttonText": "#10182c"
    },
    "taskbar": {
      "background": "#8d8da7",
      "backgroundEnd": "#e3e3ed",
      "text": "#ffffff",
      "button": "#e3e3ed",
      "activeButton": "#182036",
      "activeText": "#ffffff"
    },
    "status": {
      "background": "#ece9d8",
      "text": "#101010",
      "info": "#8d8da7",
      "success": "#287a1e",
      "warning": "#7a5200",
      "error": "#a40000"
    }
  },
  "metrics": {
    "controlHeight": "23px",
    "borderWidth": "1px",
    "bevelWidth": "1px",
    "titlebarHeight": "28px",
    "titlebarButtonSize": "21px",
    "taskbarHeight": "34px",
    "iconSize": "24px",
    "checkboxSize": "14px",
    "scrollbarWidth": "16px",
    "menuMinWidth": "176px",
    "focusOffset": "3px"
  },
  "spacing": {
    "unit": "4px",
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "xxl": "24px"
  },
  "radius": {
    "none": "0px",
    "control": "4px",
    "window": "8px",
    "menu": "3px",
    "selection": "2px"
  },
  "gradients": {
    "desktop": "linear-gradient(135deg, #182036, #8d8da7 55%, #f5f5f8)",
    "titleActive": "linear-gradient(180deg, #e3e3ed 0%, #c7c7d4 45%, #8d8da7 100%)",
    "titleInactive": "linear-gradient(180deg, #f3f3ed 0%, #c8c8bd 55%, #a8a89e 100%)",
    "button": "linear-gradient(180deg, #ffffff 0%, #f4f4ed 42%, #dcdcd1 100%)",
    "taskbar": "linear-gradient(180deg, #e3e3ed 0%, #8d8da7 48%, #182036 100%)",
    "selection": "linear-gradient(180deg, #c7c7d4, #8d8da7)",
    "progress": "linear-gradient(180deg, #b5ef8a, #42a52c 55%, #237a18)"
  },
  "shadows": {
    "window": "3px 5px 12px rgb(0 0 0 / 42%)",
    "menu": "3px 4px 8px rgb(0 0 0 / 35%)",
    "focus": "0 0 0 2px #f5f5f8",
    "dialog": "5px 8px 18px rgb(0 0 0 / 42%)"
  },
  "motion": {
    "durationFast": "80ms",
    "durationNormal": "140ms",
    "durationSlow": "220ms",
    "easing": "ease-out"
  },
  "contrastPairs": {
    "body": {
      "foreground": "#101010",
      "background": "#ece9d8",
      "minimumRatio": 4.5
    },
    "titlebar": {
      "foreground": "#10182c",
      "background": "#8d8da7",
      "minimumRatio": 4.5
    },
    "selection": {
      "foreground": "#10182c",
      "background": "#8d8da7",
      "minimumRatio": 4.5
    },
    "status": {
      "foreground": "#101010",
      "background": "#ece9d8",
      "minimumRatio": 4.5
    }
  },
  "assets": {
    "icons": "../icons/xp-luna-silver/icons.svg",
    "decorations": "../decorations/xp-luna-silver/decorations.svg",
    "texture": "../textures/xp-luna-silver.svg",
    "audio": {
      "activate": "../audio/activate.wav",
      "notify": "../audio/notify.wav",
      "complete": "../audio/complete.wav",
      "error": "../audio/error.wav"
    }
  }
}
