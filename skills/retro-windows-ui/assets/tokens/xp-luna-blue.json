{
  "schemaVersion": "1.0.0",
  "identity": {
    "id": "xp-luna-blue",
    "name": "Luna Blue",
    "family": "xp-luna",
    "era": "Windows XP",
    "variant": "blue",
    "description": "Rounded Luna chrome, glossy controls, pill-like taskbar buttons, and short eased transitions."
  },
  "typography": {
    "fontFamily": "Tahoma, 'MS Sans Serif', Geneva, sans-serif",
    "fontFamilyMono": "'Courier New', Courier, monospace",
    "roles": {
      "body": {
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.35"
      },
      "windowTitle": {
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.1"
      },
      "menu": {
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.25"
      },
      "small": {
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.3"
      },
      "code": {
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.4"
      }
    }
  },
  "colors": {
    "surface": {
      "desktop": "#245edb",
      "window": "#ece9d8",
      "windowSolid": "#ece9d8",
      "control": "#f8f8f2",
      "input": "#ffffff",
      "inset": "#ffffff",
      "menu": "#ffffff",
      "tooltip": "#ffffe1",
      "overlay": "rgb(0 0 0 / 32%)"
    },
    "text": {
      "primary": "#101010",
      "secondary": "#3e3e38",
      "muted": "#55554e",
      "disabled": "#8b8b80",
      "inverse": "#ffffff",
      "link": "#0645ad",
      "error": "#a40000"
    },
    "border": {
      "default": "#7f9db9",
      "light": "#ffffff",
      "dark": "#0a246a",
      "shadow": "#5d5d55",
      "highlight": "#eef4fb"
    },
    "bevel": {
      "outerLight": "#ffffff",
      "outerDark": "#0a246a",
      "innerLight": "#eef4fb",
      "innerDark": "#b8b8aa",
      "pressedLight": "#0a246a",
      "pressedDark": "#ffffff"
    },
    "selection": {
      "background": "#0058e6",
      "text": "#ffffff",
      "inactiveBackground": "#c5c5ba",
      "inactiveText": "#3d3d38"
    },
    "focus": {
      "color": "#0058e6",
      "ring": "1px dotted #0a246a",
      "alternate": "#ffffff"
    },
    "titlebar": {
      "activeBackground": "#0058e6",
      "activeBackgroundEnd": "#3a93ff",
      "activeText": "#ffffff",
      "inactiveBackground": "#c8c8bd",
      "inactiveBackgroundEnd": "#f3f3ed",
      "inactiveText": "#5e5e58",
      "button": "#3a93ff",
      "buttonText": "#ffffff"
    },
    "taskbar": {
      "background": "#245edb",
      "backgroundEnd": "#3f8cf3",
      "text": "#ffffff",
      "button": "#3f8cf3",
      "activeButton": "#0a246a",
      "activeText": "#ffffff"
    },
    "status": {
      "background": "#ece9d8",
      "text": "#101010",
      "info": "#0058e6",
      "success": "#287a1e",
      "warning": "#7a5200",
      "error": "#a40000"
    }
  },
  "metrics": {
    "controlHeight": "23px",
    "borderWidth": "1px",
    "bevelWidth": "1px",
    "titlebarHeight": "28px",
    "titlebarButtonSize": "21px",
    "taskbarHeight": "34px",
    "iconSize": "24px",
    "checkboxSize": "14px",
    "scrollbarWidth": "16px",
    "menuMinWidth": "176px",
    "focusOffset": "3px"
  },
  "spacing": {
    "unit": "4px",
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "xxl": "24px"
  },
  "radius": {
    "none": "0px",
    "control": "4px",
    "window": "8px",
    "menu": "3px",
    "selection": "2px"
  },
  "gradients": {
    "desktop": "linear-gradient(135deg, #0a246a, #245edb 55%, #eef4fb)",
    "titleActive": "linear-gradient(180deg, #3a93ff 0%, #0058e6 45%, #0a246a 100%)",
    "titleInactive": "linear-gradient(180deg, #f3f3ed 0%, #c8c8bd 55%, #a8a89e 100%)",
    "button": "linear-gradient(180deg, #ffffff 0%, #f4f4ed 42%, #dcdcd1 100%)",
    "taskbar": "linear-gradient(180deg, #3f8cf3 0%, #245edb 48%, #0a246a 100%)",
    "selection": "linear-gradient(180deg, #3a93ff, #0058e6)",
    "progress": "linear-gradient(180deg, #b5ef8a, #42a52c 55%, #237a18)"
  },
  "shadows": {
    "window": "3px 5px 12px rgb(0 0 0 / 42%)",
    "menu": "3px 4px 8px rgb(0 0 0 / 35%)",
    "focus": "0 0 0 2px #eef4fb",
    "dialog": "5px 8px 18px rgb(0 0 0 / 42%)"
  },
  "motion": {
    "durationFast": "80ms",
    "durationNormal": "140ms",
    "durationSlow": "220ms",
    "easing": "ease-out"
  },
  "contrastPairs": {
    "body": {
      "foreground": "#101010",
      "background": "#ece9d8",
      "minimumRatio": 4.5
    },
    "titlebar": {
      "foreground": "#ffffff",
      "background": "#0a246a",
      "minimumRatio": 4.5
    },
    "selection": {
      "foreground": "#ffffff",
      "background": "#0a246a",
      "minimumRatio": 4.5
    },
    "status": {
      "foreground": "#101010",
      "background": "#ece9d8",
      "minimumRatio": 4.5
    }
  },
  "assets": {
    "icons": "../icons/xp-luna-blue/icons.svg",
    "decorations": "../decorations/xp-luna-blue/decorations.svg",
    "texture": "../textures/xp-luna-blue.svg",
    "wallpaper": "../wallpapers/xp-luna-blue.svg",
    "startMark": "../brand/xp-luna-blue-start.svg",
    "brandMark": "../brand/xp-luna-blue-mark.svg",
    "bootExample": "../boot/index.html",
    "audio": {
      "activate": "../audio/activate.wav",
      "notify": "../audio/notify.wav",
      "complete": "../audio/complete.wav",
      "error": "../audio/error.wav"
    }
  }
}
